  estado_usuario String    @default("activa")
  correo_nuevo   String    @db.Citext
  token_hash     Bytes     @unique(map: "cambios_correo_token_unico")
  creado_en      DateTime  @default(now()) @db.Timestamptz(6)
  expira_en      DateTime  @db.Timestamptz(6)
  confirmado_en  DateTime? @db.Timestamptz(6)
  usuarios       usuarios  @relation(fields: [usuario_id, estado_usuario], references: [id, estado], onDelete: NoAction, onUpdate: NoAction, map: "cambios_correo_usuario_activo")

  @@index([expira_en], map: "cambios_correo_expira_en")
}

