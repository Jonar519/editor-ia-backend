generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model actualizaciones_documento {
  id            BigInt     @id @default(autoincrement())
  documento_id  String     @db.Uuid
  autor_id      String     @db.Uuid
  actualizacion Bytes
  creado_en     DateTime   @default(now()) @db.Timestamptz(6)
  usuarios      usuarios   @relation(fields: [autor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentos    documentos @relation(fields: [documento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([documento_id, id], map: "actualizaciones_por_documento")
}

