{
  "name": "editor-ia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API y servidor en tiempo real de Cuaderno.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "start": "node --env-file-if-exists=.env dist/servidor.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:pull": "node --env-file-if-exists=.env scripts/prisma.mjs pull",
    "prisma:check": "node --env-file-if-exists=.env scripts/prisma.mjs check",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "mutate": "node scripts/mutar.mjs",
    "env:init": "node scripts/env-init.mjs",
    "invitar": "tsx --env-file-if-exists=.env scripts/invitar.ts",
    "buzon": "tsx --env-file-if-exists=.env scripts/buzon.ts",
    "totp": "tsx scripts/totp.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-sesv2": "3.1151.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "lib0": "0.2.119",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  }
}
