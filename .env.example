# Cuaderno · editor-ia-backend · variables de entorno
#
# Crea (o completa) tu .env local con:  scripts\env-init.bat
# El script genera los secretos aleatorios y arma las URL de base de datos con la contraseña del rol
# cuaderno_app que está en el .env del repo de base (DATABASE_REPO_PATH). Si .env ya existe, solo agrega
# las variables nuevas que falten, sin cambiar las existentes. .env nunca se versiona.
# La configuración se valida con zod al arrancar: un valor inválido detiene el proceso con un mensaje claro.

# ─── Proceso ──────────────────────────────────────────────────────────────────────

# development | test | production. En production el servidor se niega a arrancar si algún proveedor
# es "mock", si falta METRICS_TOKEN, si Redis no tiene contraseña o si el usuario de base tiene
# privilegios de más (superusuario, dueño de tablas, puede crear en el esquema).
NODE_ENV=development

# Interfaz y puerto del API. 4200 para no chocar con otros proyectos; 127.0.0.1 = solo esta máquina.
HOST=127.0.0.1
PORT=4200

# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Milisegundos que el apagado ordenado (SIGTERM/SIGINT) espera a que terminen las peticiones en curso
# antes de cortar las conexiones que queden.
SHUTDOWN_TIMEOUT_MS=10000

# true solo detrás de un proxy inverso de confianza (para leer la IP real de X-Forwarded-For).
TRUST_PROXY=false

# ─── Datos ────────────────────────────────────────────────────────────────────────

# Conexión a PostgreSQL como cuaderno_app (rol de privilegios mínimos; NUNCA el dueño de las tablas).
# env-init.bat la arma con CUADERNO_APP_PASSWORD del repo de base.
# Formato: postgresql://cuaderno_app:<contraseña>@127.0.0.1:5435/cuaderno
DATABASE_URL=

# Lo mismo contra la base de PRUEBAS (cuaderno_test). La usan las pruebas y prisma db pull; nunca la app.
TEST_DATABASE_URL=

# Redis (BullMQ, límites de tasa). Base lógica 0 = desarrollo.
# En desarrollo no tiene contraseña porque solo escucha en 127.0.0.1; en production es obligatoria
# (redis://:<contraseña>@host:puerto/0 o rediss://...).
REDIS_URL=redis://127.0.0.1:6381/0

# Redis para las pruebas: base lógica 1 (nunca la 0 de desarrollo).
TEST_REDIS_URL=redis://127.0.0.1:6381/1

# Ruta al repo editor-ia-database (migraciones y su .env). Relativa a este repo.
DATABASE_REPO_PATH=../editor-ia-database

# ─── Secretos ─────────────────────────────────────────────────────────────────────

# Clave AES-256-GCM con la que se cifran los secretos TOTP (MFA). 32 bytes en base64.
# env-init.bat la genera. Para generarla a mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes o la cambias, los MFA ya configurados dejan de poder verificarse.
MFA_ENCRYPTION_KEY=

# Clave HMAC-SHA256 con la que se firman los access tokens (15 min). 32+ bytes en base64.
# env-init.bat la genera. A mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cambiarla invalida todos los access tokens vigentes (los refresh siguen sirviendo para pedir otros).
ACCESS_TOKEN_SECRET=

# Token para leer /metrics (cabecera Authorization: Bearer <token>). Opcional en desarrollo (vacío =
# /metrics abierto); obligatorio en production, con 32+ caracteres. env-init.bat lo genera. A mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=

# ─── Sesión y cuentas ─────────────────────────────────────────────────────────────

# Origen del frontend (sin ruta). Los enlaces de los correos se arman con él:
# <APP_URL>/#/invitacion/<token>. También se exige como Origin en las peticiones que usan la cookie
# de refresco. En production debe ser https://.
APP_URL=http://127.0.0.1:5175

# Cookie de refresco con atributo Secure. Los navegadores la aceptan sobre http://127.0.0.1 y
# http://localhost; en production debe ser true.
COOKIE_SECURE=true

# Costo de scrypt para las contraseñas: N = 2^PASSWORD_HASH_COST (r=8, p=1). 15 por defecto y
# mínimo en production. Las pruebas usan menos para ir rápido; un hash guarda su propio costo.
PASSWORD_HASH_COST=15

# ─── Correo ───────────────────────────────────────────────────────────────────────

# Remitente de los correos (invitaciones, avisos). En SES debe estar verificado.
EMAIL_FROM=cuaderno@example.com

# Región de AWS SES. Obligatoria solo con EMAIL_PROVIDER=ses. Las credenciales de AWS NO van aquí:
# el SDK las toma de la cadena estándar (rol de la instancia, perfil, variables AWS_*).
SES_REGION=

# ─── Proveedores externos (intercambiables; "mock" por defecto) ──────────────────

# IA: mock | anthropic. Lo lee el SERVICIO de IA (proceso aparte: scripts\ia.bat). mock funciona de
# punta a punta; anthropic es por ahora un esqueleto (responde "no implementado") y exige su clave.
AI_PROVIDER=mock

# Clave del proveedor real. Solo con AI_PROVIDER=anthropic. Nunca se registra ni se versiona.
ANTHROPIC_API_KEY=

# ─── Servicio de IA (gRPC, proceso aparte; ADR 0002) ─────────────────────────────

# Dónde escucha el servicio (lo lee el servicio) y adónde llama el API (IA_URL, host:puerto).
IA_HOST=127.0.0.1
IA_PORT=4210
IA_URL=127.0.0.1:4210

# Token entre el API y el servicio (metadato authorization: Bearer). 32+ bytes en base64url; el MISMO
# valor en los dos procesos (comparten este .env). env-init.bat lo genera. A mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sin él, el API arranca sin IA (503 ia_no_disponible); en production es obligatorio.
IA_SERVICE_TOKEN=

# Transporte entre los dos procesos. En production hace falta UNO de estos:
#   - TLS mutuo: rutas a los PEM (en el servicio: su certificado y la CA que firma al del API; en el API:
#     su certificado de cliente y la CA que firma al del servicio). Los tres o ninguno.
#   - IA_RED_PRIVADA=true: el tráfico va por una red privada que no sale de la máquina o la VPC.
IA_TLS_CERT=
IA_TLS_KEY=
IA_TLS_CA=
IA_RED_PRIVADA=false

# Pausa del proveedor simulado entre fragmentos, en ms (para que el streaming se vea en la demo).
IA_MOCK_RETRASO_MS=40

# Correo: mock | ses. mock guarda los correos en la tabla correos_simulados (buzón de la demo).
EMAIL_PROVIDER=mock

# Geolocalización aproximada por IP: mock | tabla_local. tabla_local usa la tabla rangos_ip_geo;
# nunca se llama a un servicio externo.
GEO_PROVIDER=mock
